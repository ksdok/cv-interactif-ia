# Éditeur — aligné sur .prettierrc (QUAL-001).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Le Markdown est hors périmètre Prettier (voir .prettierignore) et ses
# doubles espaces en fin de ligne sont signifiants.
trim_trailing_whitespace = false
